{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zephyr",
  "version": "0.1.4",
  "identifier": "org.bibletranslationtools.zephyr",
  "build": {
    "beforeDevCommand": "pnpm dev.tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build.tauri",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zephyr",
        "maximized": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
