{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Zephyr",
    "version": "0.6.4",
    "identifier": "org.bibletranslationtools.zephyr",
    "build": {
        "beforeDevCommand": "pnpm dev.tauri",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build.tauri",
        "frontendDist": "../../../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Zephyr",
                "maximized": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyODJDNEU1ODU0NjkyQ0EKUldUS2trYUY1Y1NDNGloTzF6Z29JeGpCWWhvVExCVlZVSUhlaVE1ck9jTytLR3Q2Z3RuWDFTc28K",
            "endpoints": [
                "https://updater.zephyr.bibletranslationtools.org/{{target}}/{{current_version}}"
            ]
        }
    }
}
