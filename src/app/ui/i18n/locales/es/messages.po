#: src/app/ui/i18n/usfmOnionLocalization.ts:123
msgid "\\{marker} is not allowed in this context."
msgstr "\\{marker} no está permitido en este contexto."

#: src/app/ui/i18n/usfmOnionLocalization.ts:122
msgid "\\{marker} is not allowed inside a {context}."
msgstr "\\{marker} no está permitido dentro de un {context}."

#: src/app/ui/i18n/usfmOnionLocalization.ts:111
msgid "\\{marker} is part of a footnote or cross-reference and must appear inside one."
msgstr "\\{marker} es parte de una nota al pie o referencia cruzada y debe aparecer dentro de una."

#: src/app/ui/i18n/usfmOnionLocalization.ts:114
msgid "\\{marker} must follow a \\c chapter marker."
msgstr "\\{marker} debe seguir a un marcador de capítulo \\c."

#: src/app/ui/i18n/usfmOnionLocalization.ts:117
msgid "\\{marker} must follow a \\v verse marker."
msgstr "\\{marker} debe seguir a un marcador de versículo \\v."

#: src/app/ui/i18n/usfmOnionLocalization.ts:119
msgid "\\{marker} must follow its target marker."
msgstr "\\{marker} debe seguir a su marcador de destino."

#: src/app/ui/i18n/usfmOnionLocalization.ts:169
msgid "\\{marker} needs a space after the marker name."
msgstr "\\{marker} necesita un espacio después del nombre del marcador."

#: src/app/ui/i18n/usfmOnionLocalization.ts:171
msgid "\\{marker} needs a space before the text that follows."
msgstr "\\{marker} necesita un espacio antes del texto que sigue."

#: src/app/ui/i18n/usfmOnionLocalization.ts:167
msgid "\\{marker} needs a space or newline before it."
msgstr "\\{marker} necesita un espacio o salto de línea antes de él."

#: src/app/ui/i18n/usfmOnionLocalization.ts:85
msgid "\\{marker} starts an empty paragraph — the next paragraph begins right after, with no content in between."
msgstr "\\{marker} inicia un párrafo vacío: el siguiente párrafo comienza justo después, sin contenido intermedio."

#: src/app/ui/i18n/usfmOnionLocalization.ts:136
msgid "\\{marker} was never closed; \\{closer}* closed it indirectly. Add an explicit \\{marker}* before \\{closer}*."
msgstr "\\{marker} nunca se cerró; \\{closer}* lo cerró indirectamente. Agrega un \\{marker}* explícito antes de \\{closer}*."

#: src/app/ui/i18n/usfmOnionLocalization.ts:134
msgid "\\{marker}* does not match the marker that is currently open."
msgstr "\\{marker}* no coincide con el marcador que está actualmente abierto."

#: src/app/ui/i18n/usfmOnionLocalization.ts:130
msgid "\\{marker}* has no matching opening \\{marker}."
msgstr "\\{marker}* no tiene un \\{marker} de apertura correspondiente."

#: src/app/ui/i18n/usfmOnionLocalization.ts:173
msgid "\\{marker}* is directly followed by text with no space. If this is an intentional contraction (e.g. \\nd Lord\\nd*'s) you can ignore this."
msgstr "\\{marker}* va seguido directamente de texto sin espacio. Si es una contracción intencional (p. ej. \\nd Señor\\nd*'s), puedes ignorarlo."

#: src/app/ui/i18n/usfmOnionLocalization.ts:99
msgid "\\{marker}* is not a known closing marker."
msgstr "\\{marker}* no es un marcador de cierre conocido."

#: src/app/ui/i18n/usfmOnionLocalization.ts:87
msgid "\\c needs a chapter number after it."
msgstr "\\c necesita un número de capítulo a continuación."

#: src/app/ui/i18n/usfmOnionLocalization.ts:83
msgid "\\id must come before any other content."
msgstr "\\id debe aparecer antes que cualquier otro contenido."

#: src/app/ui/i18n/usfmOnionLocalization.ts:178
msgid "\\v is not allowed inside a non-content paragraph; verses must appear inside body paragraphs, lists, or tables."
msgstr "\\v no está permitido dentro de un párrafo sin contenido; los versículos deben aparecer dentro de párrafos de cuerpo, listas o tablas."

#: src/app/ui/i18n/usfmOnionLocalization.ts:176
msgid "\\v is not allowed inside a section heading; verses must appear inside body paragraphs, lists, or tables."
msgstr "\\v no está permitido dentro de un encabezado de sección; los versículos deben aparecer dentro de párrafos de cuerpo, listas o tablas."

#: src/app/ui/i18n/usfmOnionLocalization.ts:89
msgid "\\v needs a verse number after it."
msgstr "\\v necesita un número de versículo a continuación."

