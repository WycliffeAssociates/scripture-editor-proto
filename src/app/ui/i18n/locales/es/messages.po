#: src/app/ui/i18n/usfmOnionLocalization.ts:180
msgid "\\{marker} is a blank line and takes no content; put this content in its own paragraph (\\p, \\q, …)."
msgstr "\\{marker} es una línea en blanco y no admite contenido; coloca este contenido en su propio párrafo (\\p, \\q, …)."

#: src/app/ui/i18n/usfmOnionLocalization.ts:125
msgid "\\{marker} is a milestone and needs to end with \\*."
