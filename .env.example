# API Configuration
# Language API for searching and importing scripture repositories
# Default: https://api.bibleineverylanguage.org/api/rest/consolidated-repos
VITE_LANGUAGE_API_URL=https://api.bibleineverylanguage.org/api/rest/consolidated-repos
# Web/browser API and session calls should point at the direct Gitea host.
VITE_GITEA_WEB_HOST=
# Web/browser Git transport should point at the dedicated corsProxy URL.
VITE_GIT_CORS_PROXY_URL=
# Desktop/Tauri should point at the direct Gitea host.
VITE_GITEA_DESKTOP_HOST=
VITE_GIT_PROXY_X_REQUESTED_WITH=

# Build Information (set by CI/CD)
VITE_VERSION_TAG=
VITE_GITHUB_SHA=
