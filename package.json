{
    "name": "zephyr",
    "version": "0.1.4",
    "private": true,
    "type": "module",
    "scripts": {
        "dev.tauri": "vite --config vite.tauri.config.ts",
        "dev.web": "vite dev --config vite.web.config.ts --port 5175",
        "build.tauri": "vite build --config vite.tauri.config.ts",
        "build.web": "vite build --config vite.web.config.ts",
        "preview": "vite preview --outDir ./dist-web",
        "tauri": "tauri",
        "tauri-dev": "tauri dev",
        "tauri-build": "tauri build",
        "lingui": "lingui",
        "lingui-extract": "lingui extract",
        "lingui-compile": "lingui compile --typescript",
        "check": "tsc --noEmit",
        "format": "biome check --write .",
        "test": "vitest",
        "test.e2e.ui": "pnpm exec playwright test --ui",
        "test.e2e": "pnpm exec playwright test",
        "test:unit": "vitest run tests/unit --exclude 'tests/unit/**/*.integration.ts'",
        "test:integration": "TAURI_TEST_INTEGRATION=true vitest run --exclude 'tests/unit/**/*.test.ts' --exclude 'tests/unit/**/*.test.tsx' --exclude 'tests/unit/**/*.spec.ts' --exclude 'tests/unit/**/*.spec.tsx'",
        "test:watch": "vitest --watch",
        "knip": "knip",
        "check:architecture": "node scripts/checkArchitecture.mjs"
    },
    "dependencies": {
        "@lexical/headless": "0.35.0",
        "@lexical/react": "0.35.0",
        "@lexical/utils": "0.35.0",
        "@lingui/core": "5.5.2",
        "@lingui/react": "5.5.2",
        "@tanstack/react-query": "5.90.7",
        "@tanstack/react-router": "1.135.0",
        "@tanstack/react-virtual": "^3.13.23",
        "@tauri-apps/api": "2.9.0",
        "@tauri-apps/plugin-dialog": "~2.4.2",
        "@tauri-apps/plugin-fs": "2.4.4",
        "@tauri-apps/plugin-opener": "~2.5.3",
        "@tauri-apps/plugin-os": "~2.3.2",
        "@tauri-apps/plugin-process": "~2",
        "@tauri-apps/plugin-updater": "~2",
        "@vanilla-extract/css": "^1.19.1",
        "buffer": "^6.0.3",
        "crypto-es": "^3.1.3",
        "dexie": "^4.3.0",
        "diff": "8.0.2",
        "effect": "4.0.0-beta.67",
        "fflate": "0.8.2",
        "isomorphic-git": "^1.37.4",
        "lexical": "0.35.0",
        "lucide-react": "0.542.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-markdown": "^10.1.0",
        "usfm-onion-web": "github:WycliffeAssociates/usfm-onion#v0.0.4",
        "valibot": "^1.3.0",
        "yaml": "2.8.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.3.0",
        "@biomejs/biome": "2.2.6",
        "@lingui/babel-plugin-lingui-macro": "5.5.2",
        "@lingui/cli": "5.5.2",
        "@lingui/vite-plugin": "5.5.2",
        "@playwright/test": "1.57.0",
        "@tanstack/router-plugin": "1.135.0",
        "@tauri-apps/cli": "2.9.4",
        "@types/jsdom": "^27.0.0",
        "@types/node": "24.10.0",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@vanilla-extract/vite-plugin": "^5.2.0",
        "@vitejs/plugin-react": "4.7.0",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^27.4.0",
        "knip": "^5.88.0",
        "lefthook": "2.0.3",
        "postcss": "8.5.6",
        "postcss-preset-mantine": "1.18.0",
        "postcss-simple-vars": "7.0.1",
        "typescript": "5.9.3",
        "vite": "7.2.2",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "4.0.15",
        "wrangler": "4.94.0"
    },
    "pnpm-workspace": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild",
            "sharp",
            "workerd",
            "lefthook"
        ]
    }
}
