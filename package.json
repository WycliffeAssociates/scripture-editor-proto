{
  "name": "zephyr",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev.tauri": "vite --config vite.tauri.config.ts",
    "dev.web": "vite dev --config vite.web.config.ts --port 5175",
    "build.tauri": "pnpm run i18n && vite build --config vite.tauri.config.ts",
    "build.web": "pnpm run i18n && vite build --config vite.web.config.ts",
    "preview": "vite preview --outDir ./dist-web",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "tauri-build": "tauri build",
    "lingui": "lingui",
    "lingui-extract": "lingui extract",
    "lingui-compile": "lingui compile --typescript",
    "i18n": "lingui extract && lingui compile --typescript",
    "check": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest",
    "test.e2e.ui": "pnpm exec playwright test --ui",
    "test.e2e": "pnpm exec playwright test",
    "test:unit": "vitest run tests/unit --exclude 'tests/unit/**/*.integration.ts'",
    "test:integration": "TAURI_TEST_INTEGRATION=true vitest run --exclude 'tests/unit/**/*.test.ts' --exclude 'tests/unit/**/*.test.tsx' --exclude 'tests/unit/**/*.spec.ts' --exclude 'tests/unit/**/*.spec.tsx'",
    "test:watch": "vitest --watch",
    "knip": "knip",
    "check:architecture": "node scripts/checkArchitecture.mjs"
  },
  "dependencies": {
    "@lexical/clipboard": "0.45.0",
    "@lexical/headless": "0.45.0",
    "@lexical/react": "0.45.0",
    "@lexical/utils": "0.45.0",
    "@lingui/core": "6.2.0",
    "@lingui/react": "6.2.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-virtual": "3.14.2",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "@vanilla-extract/css": "^1.19.1",
    "buffer": "^6.0.3",
    "crypto-es": "^3.1.3",
    "dexie": "4.4.3",
    "diff": "9.0.0",
    "effect": "4.0.0-beta.67",
    "fflate": "0.8.3",
    "isomorphic-git": "1.38.4",
    "lexical": "0.45.0",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "scripture-sous-chef-web": "github:WycliffeAssociates/scripture-sous-chef#v0.0.1",
    "usfm-onion-web": "github:WycliffeAssociates/usfm-onion#v0.0.7",
    "valibot": "1.4.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.5.0",
    "@lingui/cli": "6.2.0",
    "@lingui/swc-plugin": "6.2.0",
    "@lingui/vite-plugin": "6.2.0",
    "@playwright/test": "1.60.0",
    "@tanstack/router-plugin": "1.168.18",
    "@tauri-apps/cli": "2.11.2",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react-swc": "4.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "knip": "6.16.0",
    "lefthook": "2.1.9",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "postcss": "8.5.15",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "4.1.8",
    "wrangler": "4.98.0"
  },
  "pnpm-workspace": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "workerd",
      "lefthook"
    ]
  }
}
