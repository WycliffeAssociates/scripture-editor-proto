{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["es2022", "es2023.array", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@tests/*": ["./tests/*"]
        }
    },
    "include": ["src", "tests", "src/tauri/persistence/.ts"],
    "exclude": ["node_modules", "dist", "dist-web"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
