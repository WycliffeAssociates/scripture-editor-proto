{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/web/main.tsx!", "src/app/entrypoint.tsx!"],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "tests/**/*.{ts,tsx}!",
    "!src/routeTree.gen.ts",
    "!src/app/generated/**",
    "!src/tauri/rust/**",
    "!src/app/ui/i18n/locales/**"
  ],
  "ignore": [
    "src/app/ui/components/blocks/ProjectImportHub/ProjectImportHub.tsx",
    "src/app/ui/styles/modules/projectImportHub.css.ts",
    "src/app/ui/hooks/useGiteaApi.ts",
    "src/app/ui/components/blocks/VersionsPopover.tsx",
    "src/app/ui/styles/modules/VersionsPopover.css.ts"
  ],
  "ignoreDependencies": ["buffer"],
  "tanstack-router": {
    "entry": ["src/app/routes/**/*.{ts,tsx}"]
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreIssues": {
    "**/*.css.ts": ["exports"]
  },
  "tags": ["-knipignore"]
}
